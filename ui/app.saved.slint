import { CheckBox, ComboBox, LineEdit, ScrollView, Slider, Palette } from "std-widgets.slint";

component ClickButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> active: true;
    callback clicked();
    height: 34px;
    border-radius: 8px;
    border-width: root.primary ? 0px : 1px;
    border-color: #3a4664;
    background: root.primary
        ? (ta.pressed ? #1d4ed8 : ta.has-hover ? #3b82f6 : #2563eb)
        : (ta.pressed ? #1b2436 : ta.has-hover ? #2c3850 : #242c40);
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;
        Text {
            text: root.label;
            color: root.primary ? #ffffff : #d6e4ff;
            vertical-alignment: center;
        }
    }
    opacity: root.active ? 1 : 0.4;
    ta := TouchArea {
        enabled: root.active;
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

component StepButton inherits Rectangle {
    in property <string> label;
    in property <bool> active: true;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: ta.pressed ? #1b2436 : ta.has-hover ? #31405c : #242c40;
    border-width: 1px;
    border-color: #3a4664;
    Text {
        text: root.label;
        color: #e8eef8;
        font-size: 16px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    opacity: root.active ? 1 : 0.4;
    ta := TouchArea {
        enabled: root.active;
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

component DigitStepper inherits HorizontalLayout {
    in-out property <int> value: 5;
    callback edited();
    spacing: 6px;
    alignment: center;
    StepButton {
        label: "−";
        clicked => {
            if (root.value > 1) {
                root.value += -1;
                root.edited();
            }
        }
    }
    Rectangle {
        width: 36px;
        height: 32px;
        border-radius: 8px;
        background: #1e3a5f;
        Text {
            text: root.value;
            color: #d6e4ff;
            font-size: 16px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    StepButton {
        label: "+";
        clicked => {
            if (root.value < 10) {
                root.value += 1;
                root.edited();
            }
        }
    }
}

component FieldLabel inherits Text {
    in property <string> caption;
    text: root.caption;
    color: #9aa6be;
    min-width: 96px;
    vertical-alignment: center;
}

component Section inherits Rectangle {
    in property <string> title;
    background: #171d2b;
    border-radius: 14px;
    border-width: 1px;
    border-color: #2a3348;
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        Text {
            text: root.title;
            font-size: 11px;
            font-weight: 700;
            color: #7f8da8;
        }
        @children
    }
}

export component MainWindow inherits Window {
    title: "Auto Renamer";
    default-font-family: "Segoe UI";
    default-font-size: 14px;
    background: #10141c;
    min-width: 640px;
    min-height: 680px;
    preferred-width: 700px;
    preferred-height: 1040px;

    in-out property <string> folder-text: "(no folder selected)";
    in-out property <string> prefix;
    in-out property <int> id-width: 5;
    in property <string> digit-hint: "5 digits look like 00001";
    in property <string> preview: "The next file appears once a filename is set.";
    in-out property <bool> keep-original: false;
    in-out property <string> output-folder: "renamed";
    in-out property <bool> convert: false;
    in-out property <int> format-index: 0;
    in-out property <int> quality: 90;
    in-out property <bool> resize: false;
    in-out property <string> resize-width: "1920";
    in-out property <string> resize-height: "1080";
    in property <string> status: "Choose a folder and a filename.";
    in property <string> log-text;

    callback browse-watch();
    callback browse-output();
    callback reset-counter();
    callback clear-log();
    callback edited();
    callback nudge-width(int);
    callback nudge-height(int);

    property <int> quality-shown: quality;

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    VerticalLayout {
        spacing: 0;
        Rectangle { height: 3px; background: #2563eb; }
        VerticalLayout {
            padding-left: 22px;
            padding-right: 22px;
            padding-top: 18px;
            padding-bottom: 4px;
            spacing: 4px;
            Text {
                text: "Auto Renamer";
                font-size: 22px;
                font-weight: 700;
                color: #f4f7fb;
            }
            Text {
                text: "New images get a name and a number as soon as they finish saving.";
                font-size: 13px;
                color: #8b97ad;
                wrap: word-wrap;
            }
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 18px;
                padding-top: 8px;
                spacing: 12px;

                Section {
                    title: "WATCH";
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: center;
                        FieldLabel { caption: "Folder"; }
                        LineEdit {
                            text: root.folder-text;
                            read-only: true;
                            horizontal-stretch: 1;
                        }
                        ClickButton {
                            label: "Browse";
                            primary: true;
                            clicked => { root.browse-watch(); }
                        }
                    }
                }

                Section {
                    title: "NAME";
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: center;
                        FieldLabel { caption: "Filename"; }
                        prefix-field := LineEdit {
                            text <=> root.prefix;
                            horizontal-stretch: 1;
                            placeholder-text: "screenshot";
                            edited => { root.edited(); }
                        }
                    }
                    Text {
                        text: "A number is added after an underscore, like screenshot_00001.png.";
                        font-size: 12px;
                        color: #8b97ad;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        FieldLabel { caption: "Digits"; }
                        DigitStepper {
                            value <=> root.id-width;
                            edited => { root.edited(); }
                        }
                        Text {
                            text: root.digit-hint;
                            font-size: 12px;
                            color: #8b97ad;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        ClickButton {
                            label: "Reset counter";
                            clicked => { root.reset-counter(); }
                        }
                    }
                    Rectangle {
                        background: #1e3a5f;
                        border-radius: 10px;
                        height: 44px;
                        Text {
                            text: root.preview;
                            color: #d6e4ff;
                            font-size: 15px;
                            vertical-alignment: center;
                            x: 14px;
                        }
                    }
                }

                Section {
                    title: "OUTPUT";
                    CheckBox {
                        text: "Keep original files";
                        checked <=> root.keep-original;
                        toggled => { root.edited(); }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: center;
                        FieldLabel { caption: "Folder"; opacity: root.keep-original ? 1 : 0.4; }
                        LineEdit {
                            text <=> root.output-folder;
                            horizontal-stretch: 1;
                            placeholder-text: "renamed";
                            enabled: root.keep-original;
                            edited => { root.edited(); }
                        }
                        ClickButton {
                            label: "Browse";
                            active: root.keep-original;
                            clicked => { root.browse-output(); }
                        }
                    }
                    Text {
                        text: root.keep-original
                            ? "Copies are saved in this folder. It is created if needed, and the original stays where it is. The same folder is used for rename, convert, and resize."
                            : "Turn this on to copy into a folder instead of changing the original. It applies to rename, convert, and resize.";
                        font-size: 12px;
                        color: #8b97ad;
                        wrap: word-wrap;
                    }
                }

                Section {
                    title: "IMAGE";
                    CheckBox {
                        text: "Convert";
                        checked <=> root.convert;
                        toggled => { root.edited(); }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: center;
                        FieldLabel { caption: "Format"; opacity: root.convert ? 1 : 0.4; }
                        ComboBox {
                            enabled: root.convert;
                            horizontal-stretch: 1;
                            model: ["PNG", "JPG", "WebP", "AVIF"];
                            current-index: root.format-index;
                            selected => {
                                root.format-index = self.current-index;
                                root.edited();
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        FieldLabel { caption: "Quality"; opacity: root.convert && root.format-index != 0 ? 1 : 0.4; }
                        Rectangle {
                            horizontal-stretch: 1;
                            min-width: 160px;
                            vertical-stretch: 0;
                            Slider {
                                enabled: root.convert && root.format-index != 0;
                                minimum: 1;
                                maximum: 100;
                                value: root.quality;
                                width: parent.width;
                                changed(v) => { root.quality-shown = round(v); }
                                released(v) => {
                                    root.quality = round(v);
                                    root.quality-shown = root.quality;
                                    root.edited();
                                }
                            }
                        }
                        Rectangle {
                            width: 58px;
                            height: 34px;
                            border-radius: 8px;
                            background: #1e3a5f;
                            Text {
                                text: root.quality-shown;
                                color: #d6e4ff;
                                font-size: 16px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Text {
                        text: !root.convert
                            ? "The number is kept for when conversion is turned on."
                            : root.format-index == 0
                                ? "PNG is lossless, so this number does not change the file."
                                : "1 is the smallest file    ·    100 is the highest quality";
                        font-size: 12px;
                        color: #8b97ad;
                        wrap: word-wrap;
                    }

                    CheckBox {
                        text: "Resize to fit";
                        checked <=> root.resize;
                        toggled => { root.edited(); }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        FieldLabel { caption: "Size"; opacity: root.resize ? 1 : 0.4; }
                        StepButton {
                            label: "−";
                            active: root.resize;
                            clicked => { root.nudge-width(-100); }
                        }
                        LineEdit {
                            text <=> root.resize-width;
                            input-type: number;
                            width: 84px;
                            enabled: root.resize;
                            horizontal-alignment: center;
                            edited => { root.edited(); }
                        }
                        StepButton {
                            label: "+";
                            active: root.resize;
                            clicked => { root.nudge-width(100); }
                        }
                        Text {
                            text: "×";
                            color: #8b97ad;
                            vertical-alignment: center;
                        }
                        StepButton {
                            label: "−";
                            active: root.resize;
                            clicked => { root.nudge-height(-100); }
                        }
                        LineEdit {
                            text <=> root.resize-height;
                            input-type: number;
                            width: 84px;
                            enabled: root.resize;
                            horizontal-alignment: center;
                            edited => { root.edited(); }
                        }
                        StepButton {
                            label: "+";
                            active: root.resize;
                            clicked => { root.nudge-height(100); }
                        }
                        Text {
                            text: "px";
                            color: #8b97ad;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: "Shrinks the image so it fits inside this size. Aspect ratio stays. Images that are already smaller are not enlarged.";
                        font-size: 12px;
                        color: #8b97ad;
                        wrap: word-wrap;
                    }
                }

                Text {
                text: root.status;
                color: #d5dbe8;
                font-size: 13px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: center;
                Text {
                    text: "LOG";
                    font-size: 11px;
                    font-weight: 700;
                    color: #7f8da8;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                ClickButton {
                    label: "Clear log";
                    clicked => { root.clear-log(); }
                }
            }
            Rectangle {
                background: #0c1018;
                border-radius: 12px;
                border-width: 1px;
                border-color: #2a3348;
                height: 132px;
                ScrollView {
                    VerticalLayout {
                        padding: 12px;
                        Text {
                            text: root.log-text;
                            color: #d5dbe8;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
        }
    }
}
