import { Slider, ScrollView, Palette } from "std-widgets.slint";
import "../assets/fonts/Inter-Regular.ttf";
import "../assets/fonts/Inter-SemiBold.ttf";
import "../assets/fonts/Inter-Bold.ttf";

export struct ActivityEntry {
    original: string,
    renamed: string,
    time: string,
}

component DarkButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> primary: false;
    in property <bool> active: true;
    callback clicked();

    border-radius: 6px;
    border-width: 1px;
    border-color: !root.active ? #263447 : primary ? #2a72fb : #334256;
    background: !root.active ? #15202d : primary ? (touch.pressed ? #1757dc : touch.has-hover ? #2a78ff : #1b6cf6)
                        : (touch.pressed ? #253447 : touch.has-hover ? #233244 : #182433);

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: root.active ? #f5f8ff : #68788d;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        enabled: root.active;
        clicked => { root.clicked(); }
    }
}

component DarkField inherits Rectangle {
    in-out property <string> value <=> field.text;
    in property <bool> editable: true;
    in property <bool> active: true;
    in property <string> placeholder: "";

    background: root.active ? #182331 : #141e2b;
    border-width: 1px;
    border-color: root.active && field.has-focus ? #367dfc : #3a495c;
    border-radius: 6px;
    clip: true;

    field := TextInput {
        x: 10px;
        y: 0px;
        width: parent.width - 20px;
        height: parent.height;
        single-line: true;
        read-only: !root.editable || !root.active;
        enabled: root.active;
        color: root.active ? #f1f5ff : #75849b;
        font-size: 13px;
        vertical-alignment: center;
        selection-background-color: #2669d5;
        selection-foreground-color: white;
    }

    Text {
        x: 10px;
        y: 0px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.placeholder;
        visible: field.text == "";
        color: root.active ? #778aa3 : #526278;
        font-size: 13px;
        vertical-alignment: center;
    }
}

component DarkCheck inherits Rectangle {
    in-out property <bool> checked: true;
    in property <string> label: "";

    background: transparent;

    Rectangle {
        x: 0px;
        y: (parent.height - 20px) / 2;
        width: 20px;
        height: 20px;
        border-radius: 5px;
        border-width: 1px;
        border-color: root.checked ? #4a90ff : #5d6f86;
        background: root.checked ? #1c6ef7 : #192534;
        Path {
            visible: root.checked;
            x: 2px;
            y: 2px;
            width: 16px;
            height: 16px;
            viewbox-width: 20;
            viewbox-height: 20;
            commands: "M 3 10 L 8 15 L 17 5";
            stroke: #ffffff;
            stroke-width: 3px;
            stroke-line-cap: round;
            stroke-line-join: round;
            fill: transparent;
        }
    }

    Text {
        x: 32px;
        width: parent.width - 32px;
        height: parent.height;
        text: root.label;
        color: #edf2fd;
        font-size: 14px;
        vertical-alignment: center;
    }

    // Hit target is the box. The label is not part of it.
    TouchArea {
        x: 0px;
        y: (parent.height - 20px) / 2;
        width: 20px;
        height: 20px;
        mouse-cursor: pointer;
        clicked => { root.checked = !root.checked; }
    }
}

// Commits on Enter and focus-out. Out-of-range input is clamped; junk reverts.
component NumberStep inherits Rectangle {
    in-out property <int> value: 1;
    in property <int> minimum: 0;
    in property <int> maximum: 999999;
    in property <bool> active: true;

    // Do not bind `text` to `value`. That binding recurses when Rust sets `value`.
    init => {
        entry.text = root.value;
    }
    changed value => {
        if (!entry.has-focus && entry.text != "\{root.value}") {
            entry.text = root.value;
        }
    }

    function commit() {
        if (entry.text.is-float()) {
            root.value = Math.clamp(entry.text.to-float(), root.minimum, root.maximum);
        }
        entry.text = root.value;
    }

    function increment() {
        root.commit();
        if (root.value < root.maximum) { root.value += 1; }
        entry.text = root.value;
    }

    function decrement() {
        root.commit();
        if (root.value > root.minimum) { root.value -= 1; }
        entry.text = root.value;
    }

    background: root.active ? #182331 : #141e2b;
    border-width: 1px;
    border-color: root.active && entry.has-focus ? #367dfc : root.active ? #3a495c : #263447;
    border-radius: 6px;
    clip: true;

    entry := TextInput {
        x: 10px;
        y: 0px;
        width: parent.width - 39px;
        height: parent.height;
        input-type: InputType.number;
        single-line: true;
        read-only: !root.active;
        enabled: root.active;
        color: root.active ? #f5f8ff : #75849b;
        font-size: 13px;
        vertical-alignment: center;
        selection-background-color: #2669d5;
        selection-foreground-color: white;
        accepted => { root.commit(); }
        changed has-focus => {
            if (!self.has-focus) { root.commit(); }
        }
    }

    Rectangle {
        x: parent.width - 28px;
        y: 0px;
        width: 28px;
        height: parent.height;
        background: root.active ? #202d3e : #182330;
        Rectangle { x: 0px; y: parent.height / 2; width: parent.width; height: 1px; background: root.active ? #344357 : #263447; }

        Rectangle {
            x: 0px; y: 0px; width: parent.width; height: parent.height / 2;
            background: root.active && up-area.has-hover ? #2b3a4c : transparent;
            Text {
                width: parent.width; height: parent.height;
                text: "▲"; font-size: 8px; color: root.active ? #d6e1f1 : #6b7c91;
                horizontal-alignment: center; vertical-alignment: center;
            }
            up-area := TouchArea {
                mouse-cursor: pointer;
                enabled: root.active;
                clicked => { root.increment(); }
            }
        }
        Rectangle {
            x: 0px; y: parent.height / 2;
            width: parent.width; height: parent.height / 2;
            background: root.active && down-area.has-hover ? #2b3a4c : transparent;
            Text {
                width: parent.width; height: parent.height;
                text: "▼"; font-size: 8px; color: root.active ? #d6e1f1 : #6b7c91;
                horizontal-alignment: center; vertical-alignment: center;
            }
            down-area := TouchArea {
                mouse-cursor: pointer;
                enabled: root.active;
                clicked => { root.decrement(); }
            }
        }
    }
}

// `PopupWindow` so the menu is not clipped by the row below it.
component DarkSelect inherits Rectangle {
    in property <bool> enabled: true;
    in property <[string]> choices: [];
    in property <string> value: "";
    callback selected(string);

    border-radius: 6px;
    border-width: 1px;
    border-color: menu.is-open ? #367dfc : #3a495c;
    background: !root.enabled ? #192431 : selector.has-hover ? #253344 : #1d2937;

    Text {
        x: 10px; y: 0px;
        width: parent.width - 33px; height: parent.height;
        text: root.value;
        color: root.enabled ? #eef3fd : #788698;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }

    Path {
        x: parent.width - 24px;
        y: (parent.height - 13px) / 2;
        width: 14px; height: 13px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 3 6 L 8 11 L 13 6";
        stroke: root.enabled ? #b7c5d8 : #6e7d90;
        stroke-width: 1.7px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
    }

    selector := TouchArea {
        mouse-cursor: pointer;
        enabled: root.enabled;
        clicked => { menu.show(); }
    }

    menu := PopupWindow {
        x: 0px;
        y: root.height + 3px;
        width: root.width;
        height: root.choices.length * 32px + 8px;
        close-policy: PopupClosePolicy.close-on-click-outside;

        Rectangle {
            width: parent.width; height: parent.height;
            background: #192533;
            border-width: 1px;
            border-color: #3d5169;
            border-radius: 7px;

            for option[i] in root.choices : Rectangle {
                x: 4px; y: 4px + i * 32px;
                width: parent.width - 8px; height: 32px;
                border-radius: 4px;
                background: option == root.value ? #29486e : item-touch.has-hover ? #2a394c : transparent;

                Text {
                    x: 10px; width: parent.width - 20px; height: parent.height;
                    text: option;
                    color: #eef3fd;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                item-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.selected(option);
                        menu.close();
                    }
                }
            }
        }
    }
}

export component AutoRenamer inherits Window {
    width: 800px;
    height: 710px;
    no-frame: true;
    title: "Auto Renamer";
    icon: @image-url("../assets/icon.png");
    background: #101925;
    default-font-family: "Inter";
    default-font-size: 13px;

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    in-out property <string> folder-path: "D:\\HS2\\Screenshots";
    // On: copy into output-folder-path. Off: rename inside the watched folder.
    in-out property <bool> copy-to-output-enabled: false;
    in-out property <string> output-folder-path: "";
    in-out property <string> base-name: "screenshot";
    in-out property <int> start-number: 1;
    in-out property <int> id-length: 5;
    in-out property <string> next-filename: "screenshot_00001.jpg";
    in-out property <bool> convert-enabled: true;
    in-out property <string> output-format: "JPG";
    in-out property <float> jpg-quality: 73;
    in-out property <bool> resize-enabled: false;
    in-out property <int> image-width: 1920;
    in-out property <int> image-height: 1080;
    in-out property <int> aspect-mode: 0;
    in-out property <bool> monitoring: true;
    in-out property <bool> start-with-windows: false;
    in-out property <int> processed-count: 5;
    in-out property <[ActivityEntry]> activity-log: [
        { original: "HS2_20261017_134521.png", renamed: "screenshot_00001.jpg", time: "14:36:12" },
        { original: "image (12).png",          renamed: "screenshot_00002.jpg", time: "14:36:14" },
        { original: "render_final.png",       renamed: "screenshot_00003.jpg", time: "14:36:18" },
        { original: "testshot.png",           renamed: "screenshot_00004.jpg", time: "14:36:21" },
        { original: "HS2_2026-10-17.png",     renamed: "screenshot_00005.jpg", time: "14:36:26" },
        { original: "HS2_capture_006.png",    renamed: "screenshot_00006.jpg", time: "14:37:01" },
        { original: "HS2_capture_007.png",    renamed: "screenshot_00007.jpg", time: "14:37:07" },
    ];

    callback choose-folder();
    callback choose-output-folder();
    callback open-folder();
    callback open-output-folder();
    callback reset-id-requested();
    callback edited();

    changed base-name => { root.edited(); }
    changed start-number => { root.edited(); }
    changed id-length => { root.edited(); }
    changed copy-to-output-enabled => { root.edited(); }
    changed convert-enabled => { root.edited(); }
    changed output-format => { root.edited(); }
    changed jpg-quality => { root.edited(); }
    changed resize-enabled => { root.edited(); }
    changed image-width => { root.edited(); }
    changed image-height => { root.edited(); }
    changed aspect-mode => { root.edited(); }
    changed start-with-windows => { root.edited(); }

    Rectangle {
        background: #101925;
        border-width: 1px;
        border-color: #304052;
        border-radius: 10px;
        clip: true;

        Rectangle {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: 46px;
            background: #131f2e;

            WindowMoveArea {
                width: parent.width;
                height: parent.height;

                Rectangle {
                    x: 14px;
                    y: (parent.height - 26px) / 2;
                    width: 220px;
                    height: 26px;
                    background: transparent;

                    Image {
                        x: 0px;
                        y: 0px;
                        width: 26px;
                        height: 26px;
                        source: @image-url("../assets/icon.png");
                    }

                    Text {
                        x: 40px;
                        y: -2px;
                        width: 180px;
                        height: 26px;
                        text: "Auto Renamer";
                        color: #f4f7fc;
                        font-size: 16px;
                        font-weight: 650;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    x: parent.width - 84px;
                    y: 3px;
                    width: 36px;
                    height: 36px;
                    border-radius: 5px;
                    background: min-touch.has-hover ? #27364a : transparent;
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: "−";
                        color: #e4edff;
                        font-size: 18px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    min-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.minimized = true; }
                    }
                }

                Rectangle {
                    x: parent.width - 44px;
                    y: 3px;
                    width: 36px;
                    height: 36px;
                    border-radius: 5px;
                    background: close-touch.has-hover ? #bb3441 : transparent;
                    Path {
                        x: 9px;
                        y: 9px;
                        width: 18px;
                        height: 18px;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: "M 5 5 L 19 19 M 19 5 L 5 19";
                        stroke: #f3f7ff;
                        stroke-width: 2.5px;
                        stroke-line-cap: round;
                        fill: transparent;
                    }
                    close-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.close(); }
                    }
                }
            }
        }

        Rectangle { x: 1px; y: 46px; width: parent.width - 2px; height: 1px; background: #344255; }

        Text { x: 20px; y: 72px; width: 110px; height: 30px; text: "Source folder"; color: #eff4fe; font-size: 14px; vertical-alignment: center; }
        DarkField { x: 136px; y: 68px; width: 438px; height: 36px; value <=> root.folder-path; editable: false; }

        Rectangle {
            x: 584px; y: 68px; width: 42px; height: 36px;
            background: folder-touch.pressed ? #253447 : folder-touch.has-hover ? #263346 : #192635;
            border-width: 1px;
            border-color: #344357;
            border-radius: 6px;

            Path {
                x: 10px; y: 9px; width: 22px; height: 18px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: "M 3 7 L 3 6 Q 3 4 5 4 L 10 4 L 12.5 7 L 19 7 Q 21 7 21 9 L 21 18 Q 21 20 19 20 L 5 20 Q 3 20 3 18 Z";
                stroke: #e6eefb;
                stroke-width: 1.8px;
                stroke-line-cap: round;
                fill: transparent;
            }

            folder-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open-folder(); }
            }
        }
        DarkButton { x: 636px; y: 68px; width: 144px; height: 36px; primary: true; label: "Browse"; clicked => { root.choose-folder(); } }

        Text { x: 20px; y: 126px; width: 100px; height: 30px; text: "Filename"; color: #eff4fe; font-size: 14px; vertical-alignment: center; }
        DarkField { x: 136px; y: 122px; width: 350px; height: 36px; value <=> root.base-name; }

        Text { x: 498px; y: 124px; width: 40px; height: 30px; text: "Start"; color: #e8edf8; vertical-alignment: center; }
        NumberStep { x: 544px; y: 122px; width: 76px; height: 36px; value <=> root.start-number; minimum: 1; }
        Text { x: 630px; y: 124px; width: 76px; height: 30px; text: "ID digits"; color: #e8edf8; vertical-alignment: center; }
        NumberStep { x: 706px; y: 122px; width: 74px; height: 36px; value <=> root.id-length; minimum: 1; maximum: 10; }

        Text { x: 136px; y: 163px; width: 520px; height: 18px; text: "Example: \{root.next-filename}"; font-size: 12px; color: #a6b7d1; }
        Rectangle { x: 20px; y: 188px; width: parent.width - 40px; height: 1px; background: #2c3a4b; }

        DarkCheck {
            x: 20px; y: 197px; width: 265px; height: 34px;
            label: "Copy to output folder";
            checked <=> root.copy-to-output-enabled;
        }
        Text {
            x: 310px; y: 200px; width: 465px; height: 28px;
            text: root.copy-to-output-enabled ? (root.output-folder-path == "" ? "Select an output folder" : "Original files will be kept") : "When unchecked, original files will be replaced";
            color: root.copy-to-output-enabled && root.output-folder-path == "" ? #e9b66b : root.copy-to-output-enabled ? #9ac0e9 : #a3afc2;
            font-size: 12px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        Text { x: 20px; y: 240px; width: 110px; height: 30px; text: "Output folder"; color: root.copy-to-output-enabled ? #eff4fe : #78889e; font-size: 14px; vertical-alignment: center; }
        DarkField {
            x: 136px; y: 237px; width: 438px; height: 36px;
            value <=> root.output-folder-path;
            editable: false;
            active: root.copy-to-output-enabled;
            placeholder: "No output folder selected";
        }

        Rectangle {
            x: 584px; y: 237px; width: 42px; height: 36px;
            background: !root.copy-to-output-enabled ? #15202d : output-folder-touch.pressed ? #253447 : output-folder-touch.has-hover ? #263346 : #192635;
            border-width: 1px;
            border-color: root.copy-to-output-enabled ? #344357 : #263447;
            border-radius: 6px;

            Path {
                x: 10px; y: 9px; width: 22px; height: 18px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: "M 3 7 L 3 6 Q 3 4 5 4 L 10 4 L 12.5 7 L 19 7 Q 21 7 21 9 L 21 18 Q 21 20 19 20 L 5 20 Q 3 20 3 18 Z";
                stroke: root.copy-to-output-enabled ? #e6eefb : #6b7c91;
                stroke-width: 1.8px;
                stroke-line-cap: round;
                fill: transparent;
            }

            output-folder-touch := TouchArea {
                mouse-cursor: pointer;
                enabled: root.copy-to-output-enabled;
                clicked => { root.open-output-folder(); }
            }
        }
        DarkButton {
            x: 636px; y: 237px; width: 144px; height: 36px;
            primary: true;
            label: "Browse";
            active: root.copy-to-output-enabled;
            clicked => { root.choose-output-folder(); }
        }
        Rectangle { x: 20px; y: 288px; width: parent.width - 40px; height: 1px; background: #2c3a4b; }

        // Dividers at y=288 and y=358. Row center is y=323.
        DarkCheck { x: 20px; y: 302px; width: 255px; height: 42px; label: "Auto convert"; checked <=> root.convert-enabled; }
        Text { x: 286px; y: 306px; width: 54px; height: 34px; text: "Format"; color: #e8edf8; vertical-alignment: center; }
        DarkSelect {
            x: 346px; y: 305px; width: 120px; height: 36px;
            choices: ["JPG", "PNG", "WEBP", "AVIF", "BMP"];
            value: root.output-format;
            enabled: root.convert-enabled;
            selected(option) => { root.output-format = option; }
        }
        Text { x: 484px; y: 306px; width: 56px; height: 34px; text: "Quality"; color: #e8edf8; vertical-alignment: center; }
        Slider {
            x: 554px; y: 311px; width: 110px; height: 24px;
            minimum: 1; maximum: 100; step: 1;
            value <=> root.jpg-quality;
            enabled: root.convert-enabled && (root.output-format == "JPG" || root.output-format == "WEBP" || root.output-format == "AVIF");
        }
        Rectangle {
            x: 692px; y: 305px; width: 88px; height: 36px;
            background: root.convert-enabled && (root.output-format == "JPG" || root.output-format == "WEBP" || root.output-format == "AVIF") ? #192635 : #141e2b;
            border-width: 1px;
            border-color: root.convert-enabled && (root.output-format == "JPG" || root.output-format == "WEBP" || root.output-format == "AVIF") ? #3b4a5d : #263447;
            border-radius: 6px;
            Text {
                width: parent.width; height: parent.height;
                text: "\{root.jpg-quality}";
                color: root.convert-enabled && (root.output-format == "JPG" || root.output-format == "WEBP" || root.output-format == "AVIF") ? #f2f6ff : #75849b;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Rectangle { x: 20px; y: 358px; width: parent.width - 40px; height: 1px; background: #2c3a4b; }

        // Dividers at y=358 and y=428. Row center is y=393.
        DarkCheck { x: 20px; y: 372px; width: 255px; height: 42px; label: "Resize images"; checked <=> root.resize-enabled; }
        Text { x: 280px; y: 379px; width: 78px; height: 28px; text: "Dimensions"; color: root.resize-enabled ? #e8edf8 : #78889e; vertical-alignment: center; }
        NumberStep { x: 358px; y: 375px; width: 90px; height: 36px; value <=> root.image-width; minimum: 1; maximum: 16384; active: root.resize-enabled; }
        Text { x: 454px; y: 379px; width: 18px; height: 28px; text: "×"; color: root.resize-enabled ? #d5e0ef : #6b7c91; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
        NumberStep { x: 478px; y: 375px; width: 90px; height: 36px; value <=> root.image-height; minimum: 1; maximum: 16384; active: root.resize-enabled; }
        DarkSelect {
            x: 578px; y: 375px; width: 202px; height: 36px;
            choices: ["Keep aspect ratio", "Stretch image"];
            value: root.aspect-mode == 0 ? "Keep aspect ratio" : "Stretch image";
            enabled: root.resize-enabled;
            selected(option) => { root.aspect-mode = option == "Keep aspect ratio" ? 0 : 1; }
        }
        Rectangle { x: 20px; y: 428px; width: parent.width - 40px; height: 1px; background: #2c3a4b; }

        Rectangle {
            x: 20px; y: 442px; width: parent.width - 40px; height: 170px;
            border-width: 1px;
            border-color: #36465a;
            border-radius: 8px;
            background: #111c29;

            Text {
                x: 14px; y: 6px; width: parent.width - 28px; height: 28px;
                text: "Recent activity";
                color: #f3f6ff;
                font-size: 15px;
                font-weight: 650;
                vertical-alignment: center;
            }
            Rectangle { x: 0px; y: 38px; width: parent.width; height: 1px; background: #324154; }

            ScrollView {
                x: 8px; y: 42px;
                width: parent.width - 16px;
                height: parent.height - 50px;
                content-width: 730px;
                content-height: root.activity-log.length * 31px;
                vertical-scrollbar-policy: ScrollBarPolicy.always-on;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

                for entry[i] in root.activity-log : Rectangle {
                    x: 0px; y: i * 31px;
                    width: 730px; height: 31px;
                    background: Math.mod(i, 2) == 0 ? #121e2b : #14202e;

                    Text {
                        x: 8px; y: 0px; width: 255px; height: parent.height;
                        text: entry.original;
                        color: #e9f0fc;
                        font-size: 12px;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    Text {
                        x: 264px; y: 0px; width: 20px; height: parent.height;
                        text: "→";
                        color: #98abc6;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    Text {
                        x: 296px; y: 0px; width: 300px; height: parent.height;
                        text: entry.renamed;
                        color: #ecf2fd;
                        font-size: 12px;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    Text {
                        x: 620px; y: 0px; width: 78px; height: parent.height;
                        text: entry.time;
                        color: #99abc5;
                        font-size: 11px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Footer from y=647. Status, startup check, and Reset ID share that band.
        Rectangle { x: 1px; y: 646px; width: parent.width - 2px; height: 1px; background: #2d3b4e; }
        footer := Rectangle {
            x: 1px;
            y: 647px;
            width: parent.width - 2px;
            height: parent.height - 647px;
            background: transparent;

            Rectangle {
                x: 19px;
                y: (parent.height - 14px) / 2;
                width: 14px;
                height: 14px;
                border-radius: 7px;
                background: root.monitoring ? #36d768 : #788498;
            }

            Text {
                x: 45px;
                y: 0px;
                width: parent.width - 430px;
                height: parent.height;
                text: root.monitoring ? "Running   ·   \{root.processed-count} files processed" : "Stopped   ·   \{root.processed-count} files processed";
                color: root.monitoring ? #dbe6f5 : #a5b1c3;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
            }

            DarkCheck {
                x: parent.width - 371px;
                y: 0px;
                width: 210px;
                height: parent.height;
                label: "Start with Windows";
                checked <=> root.start-with-windows;
            }

            DarkButton {
                x: parent.width - 149px;
                y: (parent.height - 34px) / 2;
                width: 130px;
                height: 34px;
                label: "Reset ID";
                clicked => { root.reset-id-requested(); }
            }
        }
    }
}
